  "contract_version": "1.0.0",
  "implementation_status": "normative-specification-only",
  "runtime_conformance_verified": false,
  "decision_enforcement": "Permit-only authorization; Deny/Indeterminate/Error block",
  "reason_vocabulary": [
    "DefaultDenied",
    "ExplicitDeny",
    "MissingRequiredAttribute",
    "SecurityCategoryInsufficient",
    "UnsupportedProfile",
