    "AdapterInvalidInput"
  ],
  "invariants": [
    {
      "id": "SEC-001",
      "requirement": "Every policy declares an explicit default effect; builders choose Deny.",
      "implementation_issue": "FOSS-429",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-002",
      "requirement": "A matching non-waived Deny dominates Allow; unmatched requests never implicitly Permit.",
      "implementation_issue": "FOSS-435",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-003",
      "requirement": "Indeterminate, validation errors and evaluation errors are non-authorizing at enforcement boundaries.",
      "implementation_issue": "FOSS-435",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-004",
      "requirement": "Unknown mandatory facts cannot satisfy requirements or produce Permit.",
      "implementation_issue": "FOSS-435",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-005",
      "requirement": "Composition is monotonic for mandatory baseline requirements; overlays cannot silently weaken policy.",
      "implementation_issue": "FOSS-437",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-006",
      "requirement": "Waivers are explicit, attributable, authorized, precisely scoped, time-bounded and limited to explicitly waivable controls.",
      "implementation_issue": "FOSS-443",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-007",
      "requirement": "Temporal semantics require injected evaluation time with deterministic boundary handling.",
      "implementation_issue": "FOSS-439",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-008",
      "requirement": "Algorithm, operation, parameters and exact profile identity must be checked; no approximate alias or security-category downgrade.",
      "implementation_issue": "FOSS-445",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-009",
      "requirement": "Draft, experimental, deprecated and unknown profiles never inherit standardized or approved status by inference.",
      "implementation_issue": "FOSS-445",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-010",
      "requirement": "Observed, configured, negotiated, inferred and absent evidence remain distinct; partial coverage never proves compliance.",
      "implementation_issue": "FOSS-447",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-011",
      "requirement": "Provider capability, origin, exportability and protection assurance must be trustworthy and complete for required decisions.",
      "implementation_issue": "FOSS-449",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-012",
      "requirement": "Untrusted format identifiers and data require bounded parsing and explicit unsupported results, never fallback to a similar profile.",
      "implementation_issue": "FOSS-452",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-013",
      "requirement": "Import cycles, unresolved imports and conflicting exact mandatory requirements fail before Permit.",
      "implementation_issue": "FOSS-437",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-014",
      "requirement": "Policy, selector, import, exception, batch, adapter and diagnostic resources are bounded.",
      "implementation_issue": "FOSS-433",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-015",
      "requirement": "Diagnostics and observability disclose stable codes and safe identifiers, not credentials, private key material or raw sensitive context.",
      "implementation_issue": "FOSS-45",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-016",
      "requirement": "Canonical decisions, reasons and policy/registry identities are reproducible from the same explicit inputs.",
      "implementation_issue": "FOSS-435",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-017",
      "requirement": "Downstream enforcement must authorize exclusively on a valid Permit; other results block protected operations.",
      "implementation_issue": "FOSS-440",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-018",
      "requirement": "Hybrid and composite transition policy references a named exact construction, never a generic hybrid flag.",
      "implementation_issue": "FOSS-458",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-019",
      "requirement": "Unknown security-critical schema fields and unsupported versions are rejected rather than ignored.",
      "implementation_issue": "FOSS-429",
      "maturity": "pending-runtime"
    },
    {
      "id": "SEC-020",
      "requirement": "Policy issuer claims and exception approval metadata are not proof of authenticity; caller trust must be established.",
      "implementation_issue": "FOSS-429",
      "maturity": "pending-runtime"
    }
  ],
